{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bang/linkcard",
  "version": "0.10.1",
  "title": "链接卡",
  "category": "bang-blocks",
  "icon": "admin-links",
  "description": "一张站点卡片，外链经中转确认页在新标签打开。",
  "keywords": ["链接", "站点", "link"],
  "textdomain": "bang",
  "supports": {
    "align": false,
    "anchor": true,
    "className": true
  },
  "attributes": {
    "url": { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" },
    "description": { "type": "string", "default": "" }
  },
  "example": {
    "attributes": {
      "url": "https://example.com/",
      "title": "一个值得留下的站点",
      "description": "写在卡片上的一句话说明。"
    }
  }
}
