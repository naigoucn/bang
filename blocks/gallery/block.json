{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "pianke/gallery",
  "version": "0.10.1",
  "title": "图集",
  "category": "pianke-blocks",
  "icon": "images-alt",
  "description": "一组图片，主图加缩略条或拼贴宫格，点击可放大查看。",
  "keywords": ["图集", "多图", "gallery"],
  "textdomain": "pianke",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "className": true,
    "spacing": { "margin": true, "padding": false }
  },
  "attributes": {
    "images": {
      "type": "array",
      "default": [],
      "items": { "type": "object" }
    },
    "layout": {
      "type": "string",
      "default": "stack",
      "enum": ["stack", "grid", "marquee"]
    },
    "caption": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": { "layout": "stack" }
  }
}
