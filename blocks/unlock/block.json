{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bang/unlock",
  "version": "0.13.32",
  "title": "阅读解锁",
  "category": "bang-blocks",
  "icon": "lock",
  "description": "把一段内容锁起来：作者五选一（登录 / 点赞 / 回复 / 密码 / 点赞+评论），读者只能用选定的方式解锁。选「密码可见」可设专属密码；「点赞+评论可见」两步都完成才放行。入群已屏蔽。",
  "keywords": ["解锁", "登录可见", "点赞可见", "回复可见", "密码可见", "叠加解锁", "unlock", "lock"],
  "textdomain": "bang",
  "supports": {
    "align": false,
    "anchor": true,
    "className": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "desc": {
      "type": "string",
      "default": ""
    },
    "teaser": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string",
      "default": ""
    },
    "method": {
      "type": "string",
      "default": "login",
      "enum": ["login", "like", "comment", "password", "combo"]
    },
    "password": {
      "type": "string",
      "default": ""
    },
    "locked": {
      "type": "boolean",
      "default": true
    }
  },
  "example": {
    "attributes": {
      "method": "login",
      "teaser": "前面的内容所有人都能看到……",
      "content": "这一段需按上方选定的方式解锁后可见。"
    }
  }
}
